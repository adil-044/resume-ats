{
  "$schema": "https://railway.app/proposals/railway-v1.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt && python -m spacy download en_core_web_sm"
  },
  "deploy": {
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-9000}",
    "restartPolicyType": "ON_FAILURE"
  }
}
